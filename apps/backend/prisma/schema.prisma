generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Empresa / Company
// ──────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  cuit      String?  @unique @db.VarChar(20)
  logo      String?  @db.Text
  email     String?  @db.VarChar(200)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  locale    String   @default("es-AR") @db.VarChar(10)
  currency  String   @default("ARS") @db.VarChar(3)
  timezone  String   @default("America/Argentina/Tucuman") @db.VarChar(50)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users     User[]
  farms     Farm[]
  roles     Role[]
  settings  Setting[]
  suppliers Supplier[]
  costs     Cost[]
  harvests  Harvest[]

  @@map("companies")
}

// ──────────────────────────────────────────────
// Roles
// ──────────────────────────────────────────────

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  code        String           @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(300)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  deletedAt   DateTime?        @map("deleted_at")

  company       Company          @relation(fields: [companyId], references: [id])
  users         User[]
  rolePermissions RolePermission[]

  @@unique([companyId, code])
  @@map("roles")
}

// ──────────────────────────────────────────────
// Permisos / Permissions
// ──────────────────────────────────────────────

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(300)
  module      String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ──────────────────────────────────────────────
// Usuarios / Users
// ──────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  email           String    @unique @db.VarChar(200)
  passwordHash    String    @map("password_hash") @db.Text
  avatar          String?   @db.Text
  phone           String?   @db.VarChar(50)
  position        String?   @db.VarChar(100)
  language        String    @default("es") @db.VarChar(5)
  timezone        String    @default("America/Argentina/Tucuman") @db.VarChar(50)
  status          String    @default("active") @db.VarChar(20)
  refreshTokenHash String?  @map("refresh_token_hash") @db.Text
  lastAccessAt    DateTime? @map("last_access_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company  Company  @relation(fields: [companyId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])
  costs    Cost[]
  sessions Session[]

  @@map("users")
}

// ──────────────────────────────────────────────
// Sesiones / Sessions
// ──────────────────────────────────────────────

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.Text
  ipAddress   String?   @map("ip_address") @db.VarChar(50)
  userAgent   String?   @map("user_agent") @db.Text
  deviceInfo  String?   @map("device_info") @db.VarChar(200)
  location    String?   @db.VarChar(200)
  isActive    Boolean   @default(true) @map("is_active")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiredAt   DateTime? @map("expired_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("sessions")
}

// ──────────────────────────────────────────────
// Establecimiento / Farm
// ──────────────────────────────────────────────

model Farm {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  location    String?  @db.VarChar(300)
  totalArea   Decimal? @map("total_area") @db.Decimal(12, 4)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  fields  Field[]
  costs   Cost[]
  harvests Harvest[]

  @@map("farms")
}

// ──────────────────────────────────────────────
// Configuración / Settings
// ──────────────────────────────────────────────

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@map("settings")
}

// ──────────────────────────────────────────────
// Auditoría / Audit Log
// ──────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  userName    String?   @map("user_name") @db.VarChar(200)
  action      String    @db.VarChar(50)
  entity      String    @db.VarChar(100)
  entityId    String?   @map("entity_id") @db.VarChar(50)
  description String?   @db.VarChar(500)
  oldValues   Json?     @map("old_values")
  newValues   Json?     @map("new_values")
  ipAddress   String?   @map("ip_address") @db.VarChar(50)
  userAgent   String?   @map("user_agent") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// Catálogos
// ──────────────────────────────────────────────

model FieldStatus {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique @db.VarChar(50)
  name   String  @db.VarChar(100)
  fields Field[]

  @@map("field_statuses")
}

model Variety {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique @db.VarChar(50)
  name              String    @db.VarChar(200)
  origin            String?   @db.VarChar(100)
  cycle             String?   @db.VarChar(50)
  potentialYieldMin Decimal?  @db.Decimal(8, 2)
  potentialYieldMax Decimal?  @db.Decimal(8, 2)
  diseaseTolerance  String?   @db.Text
  pestTolerance     String?   @db.Text
  waterRequirement  String?   @db.VarChar(100)
  soilPreference    String?   @db.VarChar(200)
  description       String?   @db.Text
  characteristics   Json?     @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  fields            Field[]
  harvests          Harvest[]

  @@map("varieties")
}

model Campaign {
  id         String     @id @default(uuid()) @db.Uuid
  code       String     @unique @db.VarChar(20)
  name       String     @db.VarChar(100)
  startDate  DateTime   @map("start_date") @db.Date
  endDate    DateTime?  @map("end_date") @db.Date
  isActive   Boolean    @default(false) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  activities Activity[]
  costs      Cost[]
  harvests   Harvest[]

  @@map("campaigns")
}

model ActivityType {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique @db.VarChar(50)
  name            String     @db.VarChar(100)
  icon            String?    @db.VarChar(50)
  requiresProduct Boolean    @default(false) @map("requires_product")
  requiresDose    Boolean    @default(false) @map("requires_dose")
  requiresCost    Boolean    @default(false) @map("requires_cost")
  createdAt       DateTime   @default(now()) @map("created_at")
  deletedAt       DateTime?  @map("deleted_at")
  activities      Activity[]

  @@map("activity_types")
}

model CostCategory {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(50)
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(300)
  icon        String?     @db.VarChar(50)
  color       String?     @default("#6B7280") @db.VarChar(7)
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  costs       Cost[]

  @@map("cost_categories")
}

model Supplier {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @db.VarChar(200)
  cuit        String?   @db.VarChar(20)
  contactName String?   @map("contact_name") @db.VarChar(200)
  phone       String?   @db.VarChar(50)
  email       String?   @db.VarChar(200)
  address     String?   @db.Text
  notes       String?   @db.Text
  status      String    @default("active") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  costs   Cost[]

  @@map("suppliers")
}

// ──────────────────────────────────────────────
// Entidades principales
// ──────────────────────────────────────────────

model Field {
  id            String          @id @default(uuid()) @db.Uuid
  farmId        String          @map("farm_id") @db.Uuid
  name          String          @db.VarChar(200)
  description   String?         @db.Text
  areaHectares  Decimal         @map("area_hectares") @db.Decimal(12, 4)
  fieldStatusId String          @map("field_status_id") @db.Uuid
  varietyId     String?         @map("variety_id") @db.Uuid
  plantingDate  DateTime?       @map("planting_date") @db.Date
  ratoonNumber  Int             @default(1) @map("ratoon_number")
  soilType      String?         @db.VarChar(100)
  soilPh        Decimal?        @map("soil_ph") @db.Decimal(4, 2)
  estimatedProduction Decimal?  @map("estimated_production") @db.Decimal(12, 2)
  healthScore   Int?            @map("health_score")
  shiScore      Int?            @map("shi_score")
  shiLevel      String?         @map("shi_level") @db.VarChar(20)
  shiCalculatedAt DateTime?     @map("shi_calculated_at")
  lastActivity  String?         @map("last_activity") @db.VarChar(100)
  lastActivityAt DateTime?      @map("last_activity_at")
  color         String?         @default("#1DB85E") @db.VarChar(7)
  latitude      Decimal?        @db.Decimal(10, 7)
  longitude     Decimal?        @db.Decimal(10, 7)
  campaignCode  String?         @map("campaign_code") @db.VarChar(20)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  farm        Farm            @relation(fields: [farmId], references: [id])
  fieldStatus FieldStatus     @relation(fields: [fieldStatusId], references: [id])
  variety     Variety?        @relation(fields: [varietyId], references: [id])
  activities  Activity[]
  costs       Cost[]
  harvests    Harvest[]
  alerts      FieldAlert[]

  @@map("fields")
}

model FieldAlert {
  id        String   @id @default(uuid()) @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  priority  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  field Field @relation(fields: [fieldId], references: [id])

  @@map("field_alerts")
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  fieldId        String       @map("field_id") @db.Uuid
  activityTypeId String       @map("activity_type_id") @db.Uuid
  campaignId     String?      @map("campaign_id") @db.Uuid
  activityDate   DateTime     @map("activity_date") @db.Date
  title          String       @db.VarChar(200)
  productName    String?      @map("product_name") @db.VarChar(200)
  doseAmount     Decimal?     @map("dose_amount") @db.Decimal(12, 4)
  doseUnit       String?      @map("dose_unit") @db.VarChar(50)
  doseRate       Decimal?     @map("dose_rate") @db.Decimal(12, 4)
  observations   String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  field        Field        @relation(fields: [fieldId], references: [id])
  activityType ActivityType @relation(fields: [activityTypeId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  costs        Cost[]

  @@map("activities")
}

model Cost {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  farmId          String?      @map("farm_id") @db.Uuid
  fieldId         String?      @map("field_id") @db.Uuid
  costCategoryId  String       @map("cost_category_id") @db.Uuid
  supplierId      String?      @map("supplier_id") @db.Uuid
  activityId      String?      @map("activity_id") @db.Uuid
  campaignId      String       @map("campaign_id") @db.Uuid
  userId          String?      @map("user_id") @db.Uuid
  description     String?      @db.VarChar(500)
  quantity        Decimal?     @db.Decimal(12, 4)
  unit            String?      @db.VarChar(50)
  unitPrice       Decimal?     @map("unit_price") @db.Decimal(12, 2)
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("ARS") @db.VarChar(3)
  costDate        DateTime     @map("cost_date") @db.Date
  status          String       @default("active") @db.VarChar(20)
  receiptUrl      String?      @map("receipt_url") @db.Text
  observations    String?      @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  company      Company      @relation(fields: [companyId], references: [id])
  farm         Farm?        @relation(fields: [farmId], references: [id])
  field        Field?       @relation(fields: [fieldId], references: [id])
  costCategory CostCategory @relation(fields: [costCategoryId], references: [id])
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  activity     Activity?    @relation(fields: [activityId], references: [id])
  campaign     Campaign     @relation(fields: [campaignId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@map("costs")
}

model Harvest {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  farmId            String?   @map("farm_id") @db.Uuid
  fieldId           String    @map("field_id") @db.Uuid
  campaignId        String    @map("campaign_id") @db.Uuid
  varietyId         String?   @map("variety_id") @db.Uuid
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  responsible       String?   @db.VarChar(200)
  method            String    @db.VarChar(50)
  tons              Decimal   @db.Decimal(12, 2)
  tonsPerHectare    Decimal?  @map("tons_per_hectare") @db.Decimal(10, 2)
  estimatedYield    Decimal?  @map("estimated_yield") @db.Decimal(10, 2)
  sucrosePercentage Decimal?  @map("sucrose_percentage") @db.Decimal(5, 2)
  qualityGrade      String?   @map("quality_grade") @db.VarChar(20)
  humidity          Decimal?  @db.Decimal(5, 2)
  status            String    @default("completed") @db.VarChar(20)
  attachments       Json?     @default("[]")
  observations      String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  company  Company  @relation(fields: [companyId], references: [id])
  farm     Farm?    @relation(fields: [farmId], references: [id])
  field    Field    @relation(fields: [fieldId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
  variety  Variety? @relation(fields: [varietyId], references: [id])

  @@map("harvests")
}
